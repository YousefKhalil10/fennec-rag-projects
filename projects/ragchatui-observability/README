## 📖 مرجع API سريع

```python
# ── الاستعلام ──────────────────────────────────────────────────
answer = wrapper.generate("ما هو التعلم الآلي؟")
answer = wrapper.generate("ما هو RAG؟", include_sources=False)

# ── الفهرسة ────────────────────────────────────────────────────
result = wrapper.add_documents({"doc_id": "محتوى النص..."})
result = wrapper.ingest({"doc_id": "محتوى النص..."})  # مكافئ

# ── الاسترجاع المباشر ──────────────────────────────────────────
chunks = wrapper.retrieve("استعلام البحث", top_k=5)

# ── الحذف ──────────────────────────────────────────────────────
success = wrapper.delete("doc_id")  # True | False

# ── الإحصائيات ─────────────────────────────────────────────────
stats = wrapper.get_stats()

# ── تسجيل مقياس مخصص ──────────────────────────────────────────
wrapper._rec("custom.metric", 42.0, MetricType.GAUGE)

# ── التنبيهات النشطة ───────────────────────────────────────────
alerts = obs.get_active_alerts()

# ── ملخص مقياس معين ────────────────────────────────────────────
summary = obs.get_metrics_summary("rag.total_latency_ms")
# {"count": N, "mean": X, "p90": Y, "p99": Z}
```

